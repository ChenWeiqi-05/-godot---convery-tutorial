# Godot 4+ specific ignores
.godot/

# Godot-specific (can be generated by the engine)
.godot/
*.import
!.import/

# Imported textures (you likely want to keep these unless rebuilding from source)
.godot/imported/

# Editor data
.godot/editor/
.godot/editor_data/
.godot/shader_cache/
.godot/uid_cache.bin
.godot/global_script_class_cache.cfg
.godot/scene_groups_cache.cfg
*.ctex
*.d3d12.cache

# Build outputs
android/
ios/
linux/
macos/
windows/
web/
export_presets.cfg

# Mac OS
.DS_Store

# User-specific
*.user
*.userprefs
